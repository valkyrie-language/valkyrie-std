    padding: 4px 10px;
    font-size: 12px;
}
.voa-badge.large {
    padding: 6px 12px;
    font-size: 13px;
}
.voa-badge.primary {
    background: var(--voa-accent, #58a6ff);
    color: #fff;
    border-color: var(--voa-accent, #58a6ff);
}
.voa-badge.success {
    background: #238636;
    color: #fff;
    border-color: #238636;
}
.voa-badge.warning {
    background: #d29922;
    color: #fff;
    border-color: #d29922;
}
.voa-badge.error {
    background: #da3633;
    color: #fff;
    border-color: #da3633;
}
.voa-badge-dot {
    display: inline-block;
    border-radius: 50%;
    background: var(--voa-text2, #8b949e);
    vertical-align: middle;
}
.voa-badge-dot.small {
    width: 6px;
    height: 6px;
}
.voa-badge-dot.medium {
    width: 8px;
    height: 8px;
}
.voa-badge-dot.large {
    width: 10px;
    height: 10px;
}
.voa-badge-dot.primary {
    background: var(--voa-accent, #58a6ff);
}
.voa-badge-dot.success {
    background: #238636;
}
.voa-badge-dot.warning {
    background: #d29922;
}
.voa-badge-dot.error {
