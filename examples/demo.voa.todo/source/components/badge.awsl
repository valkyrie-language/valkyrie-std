<widget>
    <if condition={dot}>
        <span class="voa-badge-dot {variant} {size}"></span>
    <else/>
        <span class="voa-badge {variant} {size}">
            {children}
        </span>
    </if>
</widget>

<script>
    let variant: utf8 = "default"
    let size: utf8 = "medium"
    let dot: bool = false
</script>

