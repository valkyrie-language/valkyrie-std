<widget todo_item>
<div @class="todo-item {done ? 'done' : ''}">
    <input type="checkbox" class="checkbox" :checked="done" @change="on_toggle" />
    <span class="text">{text}</span>
    <button class="del" @click="on_remove">删除</button>
</div>
</widget>

<script>
let id: i32 = 0
let text: utf8 = ""
let done: bool = false

micro on_toggle() {
    toggle_todo(id)
}

micro on_remove() {
    remove_todo(id)
}
</script>

<style>
.todo-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-bottom: 1px solid #f3f4f6;
}
.todo-item.done .text {
    text-decoration: line-through;
    color: #9ca3af;
}
.todo-item .checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
}
.todo-item .text {
    flex: 1;
    font-size: 14px;
    color: #1f2937;
}
.todo-item .del {
    color: #ef4444;
    cursor: pointer;
    font-size: 13px;
    background: none;
    border: none;
    padding: 4px 8px;
}
.todo-item .del:hover {
    text-decoration: underline;
}
</style>
