{
    name: "demo.wechat.miniprogram",
    version: "0.1.0",
    description: "微信小程序 VOA 示例 -- WXML/WXSS + .wasm（逻辑 + asgard ui）",
    auto_link: {
        core: true,
        std: false
    },
    dependencies: {
        "std": { version: "workspace" },
        "asgard.ui": { version: "workspace" }
    },
    build: [
        {
            target: "wasm32-unknown-miniprogram-wasm",
            publish: ["mini-program"],
            source_map: true
        }
    ]
}
