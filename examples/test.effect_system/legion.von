{
    name: "test.effect_system",
    version: "0.0.0.0",
    description: "效应系统集成测试：raise/resume/catch/try/yield/链式处理",
    license: "MIT",
    dependencies: {},
    build: [
        {
            target: "nyar-unknown-windows"
        },
        {
            target: "wasm32-unknown-browser-wasm",
            source_map: true,
            typescript: true,
            wat: true,
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        },
        {
            target: "jvm-openjdk-unknown-managed"
        }
    ]
}