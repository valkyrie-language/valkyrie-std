{
    name: "test.module_system",
    version: "0.1.0",
    description: "模块系统验证 — 依赖 nyar 与 std，验证跨模块类型导入、作用域隔离与依赖解析",
    auto_link: {
        core: true,
        std: false
    },
    dependencies: {
        "nyar": { version: "workspace" },
        "std": { version: "workspace" }
    },
    build: [
        {
            target: "nyar"
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        }
    ]
}
