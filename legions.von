{
    version: "1",
    name: "valkyrie-super-workspace",
    description: "Valkyrie 超工作空间 — 嵌套 legions 分发入口",
    members: [
        "projects/asgard._",
        "projects/atlas._",
        "projects/gnosis._",
        "projects/godot._",
        "projects/legend._",
        "projects/legion._",
        "projects/nyar._",
        "projects/std.data._",
        "projects/std.adaptors._",
        "projects/titan._",
        "projects/unity._",
        "projects/yyds._",
        "projects/core",
        "projects/plotter",
        "projects/std",
        "examples/test.module_system",
        "../game.geometry_wars"
    ],
    workspace: {
        author: "Valkyrie Team",
        license: "MIT",
        version: "0.1.0",
        auto_link: {
            core: false,
            std: false
        },
        auto_log: true,
        diagnostics: {
            format: "pretty",
            level: "warning",
            color: "auto",
            symbol: "unicode",
            show_code: true,
            show_help: true,
            show_note: true,
            show_target: true
        }
    }
}
