    workspace: {
        author: "Valkyrie Team",
        license: "MIT",
        version: "0.1.0",
        auto_link: {
            core: false,
            std: false
        },
        auto_log: true,
        diagnostics: {
            format: "pretty",
            level: "warning",
            color: "auto",
            symbol: "unicode",
            show_code: true,
            show_help: true,
            show_note: true,
            show_target: true
        }
    }
