{
    version: "1",
    name: "valkyrie-super-workspace",
    description: "Valkyrie 超工作空间 — 包含所有子 workspace 的全部项目",
    members: [
        "asgard.v/projects/asgard",
        "asgard.v/projects/asgard.router",
        "asgard.v/projects/voa.runtime",
        "asgard.v/examples/test.admin",
        "asgard.v/examples/test.blog",
        "asgard.v/examples/test.build-showcase",
        "asgard.v/examples/test.dashboard",
        "asgard.v/examples/test.fullstack/backend",
        "asgard.v/examples/test.fullstack/frontend",
        "asgard.v/examples/test.fullstack/shared",
        "asgard.v/examples/test.hmr-showcase",
        "asgard.v/examples/test.router-showcase",
        "atlas.v/projects/atlas",
        "atlas.v/projects/atlas.adaptor.aliyun",
        "atlas.v/projects/atlas.adaptor.azure",
        "atlas.v/projects/atlas.adaptor.tencent",
        "examples/demo.wechat.game",
        "examples/demo.unity.game",
        "projects/core",
        "projects/nyar",
        "projects/std",
        "projects/std.data.text.v",
        "projects/std.data.text.von",
        "projects/std.data.text.msil",
        "projects/std.data.text.wat",
        "projects/std.data.text.wit",
        "projects/std.data.binary.wasm",
        "projects/std.data.binary.jvm",
        "projects/std.data.binary.clr",
        "projects/std.adaptor.clr",
        "projects/std.adaptor.jvm",
        "projects/std.adaptor.linux",
        "projects/std.adaptor.macos",
        "projects/std.adaptor.nyar",
        "projects/std.adaptor.wasi",
        "projects/std.adaptor.wasm",
        "projects/std.adaptor.windows",
        "projects/tencent.wechat.sdk",
        "projects/unity.engine.sdk",
        "projects/legion.tools"
    ],
    workspace: {
        author: "Valkyrie Team",
        license: "MIT",
        version: "0.1.0",
        auto_link: {
            core: false,
            std: false
        },
        auto_log: true,
        diagnostics: {
            format: "pretty",
            level: "warning",
            color: "auto",
            symbol: "unicode",
            show_code: true,
            show_help: true,
            show_note: true,
            show_target: true
        }
    }
}
