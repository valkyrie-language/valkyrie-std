{
    version: "1",
    name: "valkyrie-super-workspace",
    description: "Valkyrie 超工作空间 — 嵌套 legions 分发入口",
    members: [
        "projects/.asgard",
        "projects/.atlas",
        "projects/.legend",
        "projects/.legion",
        "projects/.nyar",
        "projects/.std.data",
        "projects/.std.adaptors",
        "projects/legion.tools",
        "projects/core",
        "projects/plotter",
        "projects/std",
        "projects/unity.engine.sdk",
        "projects/valkyrie.unity"
    ],
    workspace: {
        author: "Valkyrie Team",
        license: "MIT",
        version: "0.1.0",
        auto_link: {
            core: false,
            std: false
        },
        auto_log: true,
        diagnostics: {
            format: "pretty",
            level: "warning",
            color: "auto",
            symbol: "unicode",
            show_code: true,
            show_help: true,
            show_note: true,
            show_target: true
        }
    }
}
