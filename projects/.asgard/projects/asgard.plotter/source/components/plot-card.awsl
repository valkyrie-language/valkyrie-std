<widget PlotCard>
    <div class="asgard-plot-card {variant}">
        <if title != ''>
            <header class="asgard-plot-card-header">
                <h3 class="asgard-plot-card-title">{title}</h3>
                <if subtitle != ''>
                    <p class="asgard-plot-card-subtitle">{subtitle}</p>
                </if>
            </header>
        </if>
        <div class="asgard-plot-card-body">
            <div class="asgard-plot" style="width: {width}">
                {svg_html}
            </div>
        </div>
        <if footer != ''>
            <footer class="asgard-plot-card-footer">{footer}</footer>
        </if>
    </div>
</widget>

<script>
    let title: string = ""
    let subtitle: string = ""
    let footer: string = ""
    let svg_html: string = ""
    let width: string = "100%"
    let variant: string = "bordered"
</script>

<style>
.asgard-plot-card {
    background: var(--voa-card, #ffffff);
    border: 1px solid var(--voa-border, #e5e7eb);
    border-radius: 8px;
    overflow: hidden;
    color: var(--voa-text, #1a1a2e);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}
.asgard-plot-card.elevated {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
}
.asgard-plot-card.bordered {
    border-width: 1px;
}
.asgard-plot-card-header {
    padding: 12px 16px 0;
}
.asgard-plot-card-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
}
.asgard-plot-card-subtitle {
    margin: 4px 0 0;
    font-size: 13px;
    color: #666;
}
.asgard-plot-card-body {
    padding: 12px 16px 16px;
}
.asgard-plot-card-footer {
    padding: 8px 16px 12px;
    font-size: 12px;
    color: #999;
    border-top: 1px solid var(--voa-border, #e5e7eb);
}
.asgard-plot {
    display: block;
    line-height: 0;
}
.asgard-plot svg {
    display: block;
    max-width: 100%;
    height: auto;
}
</style>
