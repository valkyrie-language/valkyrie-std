{
    name: "nyar.package_manager",
    version: "workspace",
    description: "Nyar 包管理器核心（install / publish / lock / manifest）",
    type: "library",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "std": { version: "workspace" },
        "std.data.text.von": { version: "workspace" },
        "nyar.package_registry": { version: "workspace" }
    },
    build: [
        { target: "clr" },
        { target: "nyar" }
    ]
}
