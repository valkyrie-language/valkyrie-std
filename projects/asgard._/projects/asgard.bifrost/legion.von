{
    name: "asgard.bifrost",
    version: "workspace",
    description: "Asgard cross-platform self-draw rendering engine",
    type: "library",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "asgard.ui": "workspace",
        "asgard.ui.core": "workspace",
        "gnosis.gpu": "workspace",
        "gnosis.layout": "workspace",
        "gnosis.render": "workspace",
        "gnosis.text": "workspace"
    },
    build: [
        {
            target: "nyar"
        }
    ]
}
