<widget home>
<Box class="blog-home">
    <Box class="blog-container">
        <Box class="blog-layout">
            <Box class="blog-main">
                <Box class="blog-featured">
                    <Text class="blog-featured-category">{featuredPost.category}</Text>
                    <Text class="blog-featured-title">{featuredPost.title}</Text>
                    <Text class="blog-featured-excerpt">{featuredPost.excerpt}</Text>
                    <Box class="blog-meta">
                        <Text class="blog-meta-text">{featuredPost.author}</Text>
                        <Text class="blog-meta-dot">·</Text>
                        <Text class="blog-meta-text">{featuredPost.date}</Text>
                        <Text class="blog-meta-dot">·</Text>
                        <Text class="blog-meta-text">{featuredPost.readingTime}</Text>
                    </Box>
                    <Box class="blog-featured-cover">
                        <Text class="blog-featured-cover-label">Cover · 16 : 9</Text>
                    </Box>
                </Box>

                <Box class="blog-post-list">
                    <List :items="posts" class="blog-post-list-inner">
                        <Item class="blog-post-item">
                            <Text class="blog-post-title">{item.title}</Text>
                            <Text class="blog-post-excerpt">{item.excerpt}</Text>
                            <Box class="blog-meta">
                                <Text class="blog-meta-text">{item.date}</Text>
                                <Text class="blog-meta-dot">·</Text>
                                <Text class="blog-meta-text">{item.readingTime}</Text>
                            </Box>
                        </Item>
                    </List>
                </Box>
            </Box>

            <Box class="blog-sidebar">
                <Box class="blog-card">
                    <Text class="blog-card-title">分类</Text>
                    <List :items="categories" class="blog-cat-list">
                        <Item class="blog-cat-item">
                            <Text class="blog-cat-label">{item.label}</Text>
                            <Text class="blog-cat-count">{item.count}</Text>
                        </Item>
                    </List>
                </Box>

                <Box class="blog-card">
                    <Text class="blog-card-title">标签</Text>
                    <Box class="blog-tag-cloud">
                        <List :items="tags" class="blog-tag-list">
                            <Item class="blog-tag-item">
                                <Text class="blog-tag-label">{item}</Text>
                            </Item>
                        </List>
                    </Box>
                </Box>

                <Box class="blog-card">
                    <Text class="blog-card-title">订阅</Text>
                    <Text class="blog-sub-text">每周精选一篇关于编译、设计与工程的深度文章。</Text>
                    <Box class="blog-sub-form">
                        <input class="blog-sub-input" type="email" placeholder="you@example.com" :value="email" @input="onEmailInput" />
                        <button class="blog-sub-button" type="button" @click="onSubscribe">订阅</button>
                    </Box>
                </Box>
            </Box>
        </Box>

        <Box class="blog-footer">
            <Box class="blog-footer-inner">
                <Text class="blog-footer-name">Aether Log</Text>
                <Text class="blog-footer-copy">© 2026 Aether Log · Crafted with Asgard</Text>
                <Box class="blog-footer-links">
                    <a class="blog-footer-link" href="#">RSS</a>
                    <a class="blog-footer-link" href="#">归档</a>
                    <a class="blog-footer-link" href="#">关于</a>
                </Box>
            </Box>
        </Box>
    </Box>
</Box>
</widget>

<script>
let featuredPost: any = {
    category: "技术",
    title: "编译即设计：AOT 时代的前端工程范式",
    excerpt: "当运行时被前置到编译期，前端工程的边界正在被重新定义。本文从 V 语言到 WASM 的编译链路出发，讨论 AOT 一体化优化如何重塑我们对框架、运行时与产物体积的认知。",
    author: "Aether",
    date: "2026-07-02",
    readingTime: "8 min read"
}

let posts: list = [
    { title: "AOT 一体化优化：从 V 到 WASM 的旅程", excerpt: "编译器优化的每一步都在重新权衡体积、启动与可调试性。", date: "2026-06-28", readingTime: "6 min read" },
    { title: "为什么我们放弃了动态主题加载", excerpt: "运行时切主题看似灵活，实则与 AOT 的体积控制目标背道而驰。", date: "2026-06-21", readingTime: "4 min read" },
    { title: "AWSL 语义原语的设计哲学", excerpt: "少量原语加上组合规则，胜过一堆语义模糊的宿主标签。", date: "2026-06-14", readingTime: "5 min read" },
    { title: "跨平台 CSS 变量解析：浏览器、小程序与原生", excerpt: "同一份 CSS 变量，三种运行时，一套统一的解析契约。", date: "2026-06-07", readingTime: "7 min read" },
    { title: "algebraic effects 与前端框架的未来", excerpt: "效应系统让控制流成为可组合的值，框架的边界因此变得可塑。", date: "2026-05-30", readingTime: "9 min read" }
]

let categories: list = [
    { label: "技术", count: 24 },
    { label: "设计", count: 12 },
    { label: "架构", count: 9 },
    { label: "工程", count: 15 },
    { label: "随想", count: 6 },
    { label: "公告", count: 3 }
]

let tags: list = ["AOT", "WASM", "AWSL", "CSS 变量", "主题", "编译器", "V 语言", "algebraic effects", "跨平台", "设计原语"]

let mut email: utf8 = ""

micro onEmailInput(e: any) {
    email = e.value
}

micro onSubscribe() {
    emit("subscribe", { email: email })
    email = ""
}
</script>

<style>
.blog-home {
    min-height: 100vh;
    background: var(--sys-bg);
    color: var(--sys-text-primary);
}
.blog-container {
    max-width: var(--ui-container-max, 1120px);
    margin: 0 auto;
    padding: var(--ui-space-xxl, 48px) var(--ui-space-lg, 24px) var(--ui-space-xxl, 48px);
}
.blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--ui-space-xxl, 48px);
    align-items: start;
}

.blog-featured {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-md, 16px);
    padding-bottom: var(--ui-space-xxl, 48px);
    border-bottom: 1px solid var(--sys-outline);
}
.blog-featured-category {
    font-size: var(--ui-font-size-xs, 12px);
    text-transform: uppercase;
    letter-spacing: var(--ui-letter-spacing-wide, 0.08em);
    color: var(--sys-text-secondary);
}
.blog-featured-title {
    font-family: var(--ui-font-serif);
    font-size: var(--ui-font-size-xxxl, 36px);
    font-weight: var(--ui-font-weight-semibold, 600);
    line-height: var(--ui-line-height-tight, 1.15);
    letter-spacing: var(--ui-letter-spacing-tight, -0.01em);
    color: var(--sys-text-primary);
}
.blog-featured-excerpt {
    font-size: var(--ui-font-size-md, 16px);
    line-height: var(--ui-line-height-relaxed, 1.7);
    color: var(--sys-text-secondary);
    max-width: 60ch;
}
.blog-featured-cover {
    aspect-ratio: 16 / 9;
    background: var(--sys-surface-hover);
    border: 1px solid var(--sys-outline);
    border-radius: var(--ui-radius-lg, 16px);
    display: flex;
    align-items: center;
    justify-content: center;
}
.blog-featured-cover-label {
    font-family: var(--ui-font-serif);
    font-size: var(--ui-font-size-sm, 14px);
    color: var(--sys-text-tertiary, var(--sys-text-secondary));
    letter-spacing: var(--ui-letter-spacing-wide, 0.08em);
}

.blog-meta {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--ui-space-xs, 8px);
    flex-wrap: wrap;
}
.blog-meta-text {
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-secondary);
}
.blog-meta-dot {
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-tertiary, var(--sys-text-secondary));
}

.blog-post-list {
    margin-top: var(--ui-space-xxl, 48px);
}
.blog-post-list-inner {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
}
.blog-post-item {
    padding: var(--ui-space-xl, 24px) 0;
    border-bottom: 1px solid var(--sys-outline);
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-xs, 8px);
    cursor: pointer;
}
.blog-post-item:first-child {
    padding-top: 0;
}
.blog-post-title {
    font-family: var(--ui-font-serif);
    font-size: var(--ui-font-size-xl, 24px);
    font-weight: var(--ui-font-weight-medium, 500);
    line-height: var(--ui-line-height-snug, 1.3);
    color: var(--sys-text-primary);
    transition: color var(--ui-motion-fast, 120ms) ease;
}
.blog-post-item:hover .blog-post-title {
    color: var(--sys-accent, var(--sys-text-primary));
}
.blog-post-excerpt {
    font-size: var(--ui-font-size-sm, 14px);
    line-height: var(--ui-line-height-relaxed, 1.7);
    color: var(--sys-text-secondary);
}

.blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-xl, 24px);
    position: sticky;
    top: var(--ui-space-lg, 24px);
}
.blog-card {
    border: 1px solid var(--sys-outline);
    border-radius: var(--ui-radius-lg, 16px);
    padding: var(--ui-space-lg, 24px);
    background: var(--sys-surface);
}
.blog-card-title {
    font-family: var(--ui-font-serif);
    font-size: var(--ui-font-size-sm, 14px);
    text-transform: uppercase;
    letter-spacing: var(--ui-letter-spacing-wide, 0.08em);
    color: var(--sys-text-secondary);
    margin-bottom: var(--ui-space-md, 16px);
}

.blog-cat-list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
}
.blog-cat-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--ui-space-xs, 8px) 0;
    cursor: pointer;
    border-bottom: 1px solid var(--sys-outline-faint, var(--sys-outline));
}
.blog-cat-item:last-child {
    border-bottom: none;
}
.blog-cat-label {
    font-size: var(--ui-font-size-sm, 14px);
    color: var(--sys-text-primary);
}
.blog-cat-count {
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-tertiary, var(--sys-text-secondary));
    font-variant-numeric: tabular-nums;
}

.blog-tag-cloud {
    display: block;
}
.blog-tag-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--ui-space-xs, 8px);
    list-style: none;
    padding: 0;
    margin: 0;
}
.blog-tag-item {
    cursor: pointer;
}
.blog-tag-label {
    display: inline-block;
    padding: var(--ui-space-xxs, 4px) var(--ui-space-sm, 12px);
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-secondary);
    background: var(--sys-surface-hover);
    border: 1px solid var(--sys-outline);
    border-radius: var(--ui-radius-full, 999px);
    transition: color var(--ui-motion-fast, 120ms) ease, border-color var(--ui-motion-fast, 120ms) ease;
}
.blog-tag-item:hover .blog-tag-label {
    color: var(--sys-text-primary);
    border-color: var(--sys-outline-strong, var(--sys-outline));
}

.blog-sub-text {
    font-size: var(--ui-font-size-sm, 14px);
    line-height: var(--ui-line-height-relaxed, 1.7);
    color: var(--sys-text-secondary);
    margin-bottom: var(--ui-space-md, 16px);
}
.blog-sub-form {
    display: flex;
    flex-direction: row;
    gap: var(--ui-space-xs, 8px);
}
.blog-sub-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: var(--ui-space-sm, 12px) var(--ui-space-md, 16px);
    font-size: var(--ui-font-size-sm, 14px);
    color: var(--sys-text-primary);
    background: var(--sys-bg);
    border: 1px solid var(--sys-outline);
    border-radius: var(--ui-radius-md, 10px);
    outline: none;
    transition: border-color var(--ui-motion-fast, 120ms) ease;
}
.blog-sub-input::placeholder {
    color: var(--sys-text-tertiary, var(--sys-text-secondary));
}
.blog-sub-input:focus {
    border-color: var(--sys-accent, var(--sys-outline-strong, var(--sys-outline)));
}
.blog-sub-button {
    flex: 0 0 auto;
    padding: var(--ui-space-sm, 12px) var(--ui-space-lg, 24px);
    font-size: var(--ui-font-size-sm, 14px);
    font-weight: var(--ui-font-weight-medium, 500);
    color: var(--sys-on-accent, var(--sys-bg));
    background: var(--sys-accent, var(--sys-text-primary));
    border: 1px solid var(--sys-accent, var(--sys-text-primary));
    border-radius: var(--ui-radius-md, 10px);
    cursor: pointer;
    transition: opacity var(--ui-motion-fast, 120ms) ease;
}
.blog-sub-button:hover {
    opacity: var(--ui-opacity-hover, 0.85);
}

.blog-footer {
    margin-top: var(--ui-space-xxl, 64px);
    border-top: 1px solid var(--sys-outline);
    padding-top: var(--ui-space-xl, 32px);
}
.blog-footer-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-md, 16px);
    flex-wrap: wrap;
}
.blog-footer-name {
    font-family: var(--ui-font-serif);
    font-size: var(--ui-font-size-md, 16px);
    font-weight: var(--ui-font-weight-semibold, 600);
    color: var(--sys-text-primary);
}
.blog-footer-copy {
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-secondary);
}
.blog-footer-links {
    display: flex;
    flex-direction: row;
    gap: var(--ui-space-md, 16px);
}
.blog-footer-link {
    font-size: var(--ui-font-size-xs, 12px);
    color: var(--sys-text-secondary);
    text-decoration: none;
    transition: color var(--ui-motion-fast, 120ms) ease;
}
.blog-footer-link:hover {
    color: var(--sys-text-primary);
}

@media (max-width: 900px) {
    .blog-layout {
        grid-template-columns: minmax(0, 1fr);
    }
    .blog-sidebar {
        position: static;
    }
}
</style>
