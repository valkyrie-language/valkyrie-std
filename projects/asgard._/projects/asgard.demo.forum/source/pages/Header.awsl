    font-family: var(--ui-font-mono);
    font-size: var(--ui-font-size-sm, 13px);
    color: var(--sys-text-primary);
    width: 200px;
}
.forum-header-search-input::placeholder {
    color: var(--sys-text-tertiary, var(--sys-text-secondary));
}
.forum-header-new-btn {
    background: transparent;
    border: 1px solid var(--sys-accent);
    padding: var(--ui-space-xs, 4px) var(--ui-space-md);
    font-family: var(--ui-font-mono);
    cursor: pointer;
}
.forum-header-new-btn-text {
    font-family: var(--ui-font-mono);
    font-size: var(--ui-font-size-sm, 13px);
    color: var(--sys-accent);
    font-weight: 700;
}
.forum-header-new-btn:hover {
    background: var(--sys-accent);
}
.forum-header-new-btn:hover .forum-header-new-btn-text {
