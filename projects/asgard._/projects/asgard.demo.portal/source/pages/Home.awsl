            <Box class="portal-footer-bottom">
                <Text class="portal-footer-copy">© 2026 Asgard Portal. 保留所有权利。</Text>
            </Box>
        </Box>
    </Box>
</Box>
</widget>

<style>
.portal-home {
    width: 100%;
}

.portal-hero {
    background: var(--sys-surface);
    padding: var(--ui-spacing-3xl) var(--ui-spacing-lg);
    border-bottom: 1px solid var(--sys-border);
}
.portal-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--ui-spacing-md);
}
.portal-hero-badge {
    display: inline-block;
    padding: var(--ui-spacing-xs) var(--ui-spacing-md);
    background: var(--sys-primary-soft);
    color: var(--sys-primary);
    border-radius: var(--ui-radius-pill);
    font-size: var(--ui-font-size-sm);
    font-weight: var(--ui-font-weight-medium);
}
.portal-hero-title {
    font-size: var(--ui-font-size-4xl);
    font-weight: var(--ui-font-weight-bold);
    color: var(--sys-text);
    line-height: 1.2;
    max-width: 720px;
}
.portal-hero-subtitle {
    font-size: var(--ui-font-size-lg);
    color: var(--sys-text-secondary);
    line-height: 1.6;
    max-width: 640px;
}
.portal-hero-actions {
    display: flex;
    gap: var(--ui-spacing-md);
    margin-top: var(--ui-spacing-md);
}

.portal-btn {
    font-size: var(--ui-font-size-md);
    padding: var(--ui-spacing-sm) var(--ui-spacing-md);
    border-radius: var(--ui-radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}
.portal-btn-lg {
    padding: var(--ui-spacing-md) var(--ui-spacing-xl);
    font-size: var(--ui-font-size-lg);
}
.portal-btn-primary {
    background: var(--sys-primary);
    color: var(--sys-primary-fg);
    border-color: var(--sys-primary);
}
.portal-btn-primary:hover {
    background: var(--sys-primary-hover);
}
.portal-btn-outline {
    background: transparent;
    color: var(--sys-text);
    border-color: var(--sys-border);
}
.portal-btn-outline:hover {
    border-color: var(--sys-primary);
    color: var(--sys-primary);
}

.portal-stats {
    background: var(--sys-background);
    padding: var(--ui-spacing-2xl) var(--ui-spacing-lg);
}
.portal-stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ui-spacing-lg);
}
.portal-stat {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing-xs);
}
.portal-stat-number {
    font-size: var(--ui-font-size-3xl);
    font-weight: var(--ui-font-weight-bold);
    color: var(--sys-primary);
}
.portal-stat-label {
    font-size: var(--ui-font-size-md);
    color: var(--sys-text-secondary);
}

.portal-section {
    padding: var(--ui-spacing-3xl) var(--ui-spacing-lg);
    background: var(--sys-surface);
}
.portal-section-alt {
    background: var(--sys-background);
}
.portal-section-inner {
    max-width: 1200px;
    margin: 0 auto;
}
.portal-section-head {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ui-spacing-xs);
    margin-bottom: var(--ui-spacing-2xl);
}
.portal-section-eyebrow {
    font-size: var(--ui-font-size-sm);
    color: var(--sys-primary);
    font-weight: var(--ui-font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
.portal-section-title {
    font-size: var(--ui-font-size-3xl);
    font-weight: var(--ui-font-weight-bold);
    color: var(--sys-text);
}
.portal-section-subtitle {
    font-size: var(--ui-font-size-lg);
    color: var(--sys-text-secondary);
}

.portal-features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ui-spacing-lg);
}
.portal-feature-card {
    background: var(--sys-surface);
    border: 1px solid var(--sys-border);
    border-radius: var(--ui-radius-lg);
    padding: var(--ui-spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.portal-feature-card:hover {
    border-color: var(--sys-primary);
    box-shadow: var(--ui-shadow-md);
}
.portal-feature-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--ui-radius-md);
    background: var(--sys-primary-soft);
    color: var(--sys-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--ui-spacing-xs);
}
.portal-feature-icon {
    stroke-width: var(--ui-icon-stroke, 2);
}
.portal-feature-title {
    font-size: var(--ui-font-size-lg);
    font-weight: var(--ui-font-weight-semibold);
    color: var(--sys-text);
}
.portal-feature-desc {
    font-size: var(--ui-font-size-md);
    color: var(--sys-text-secondary);
    line-height: 1.6;
}

.portal-solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ui-spacing-lg);
}
.portal-solution-card {
    background: var(--sys-surface);
    border: 1px solid var(--sys-border);
    border-radius: var(--ui-radius-lg);
    padding: var(--ui-spacing-xl);
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}
.portal-solution-card:hover {
    border-color: var(--sys-primary);
    box-shadow: var(--ui-shadow-md);
}
.portal-solution-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--ui-radius-md);
    background: var(--sys-primary-soft);
    color: var(--sys-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--ui-spacing-xs);
}
.portal-solution-icon {
    stroke-width: var(--ui-icon-stroke, 2);
}
.portal-solution-title {
    font-size: var(--ui-font-size-xl);
    font-weight: var(--ui-font-weight-semibold);
    color: var(--sys-text);
}
.portal-solution-desc {
    font-size: var(--ui-font-size-md);
    color: var(--sys-text-secondary);
    line-height: 1.6;
    flex-grow: 1;
}
.portal-solution-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-spacing-xs);
    color: var(--sys-primary);
    text-decoration: none;
    font-size: var(--ui-font-size-md);
    font-weight: var(--ui-font-weight-medium);
    margin-top: var(--ui-spacing-sm);
}
.portal-solution-link:hover {
    text-decoration: underline;
}
.portal-solution-link-icon {
    stroke-width: var(--ui-icon-stroke, 2);
}

.portal-cta-banner {
    background: var(--sys-primary);
    padding: var(--ui-spacing-3xl) var(--ui-spacing-lg);
}
.portal-cta-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--ui-spacing-md);
}
.portal-cta-title {
    font-size: var(--ui-font-size-3xl);
    font-weight: var(--ui-font-weight-bold);
    color: var(--sys-primary-fg);
}
.portal-cta-subtitle {
    font-size: var(--ui-font-size-lg);
    color: var(--sys-primary-fg);
    opacity: 0.9;
    max-width: 560px;
}

.portal-footer {
    background: var(--sys-surface);
    border-top: 1px solid var(--sys-border);
    padding: var(--ui-spacing-2xl) var(--ui-spacing-lg) var(--ui-spacing-lg);
}
.portal-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
}
.portal-footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ui-spacing-xl);
    margin-bottom: var(--ui-spacing-xl);
}
.portal-footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--ui-spacing-sm);
}
.portal-footer-title {
    font-size: var(--ui-font-size-md);
    font-weight: var(--ui-font-weight-semibold);
    color: var(--sys-text);
}
.portal-footer-link {
    color: var(--sys-text-secondary);
    text-decoration: none;
    font-size: var(--ui-font-size-md);
    transition: color 0.2s ease;
}
.portal-footer-link:hover {
    color: var(--sys-primary);
}
.portal-footer-bottom {
    border-top: 1px solid var(--sys-border);
    padding-top: var(--ui-spacing-lg);
}
.portal-footer-copy {
    font-size: var(--ui-font-size-sm);
    color: var(--sys-text-muted);
}
</style>
