<widget Header>
<Box class="qa-header">
    <Box class="qa-header-inner">
        <Box class="qa-header-brand">
            <Box class="qa-header-logo">
                <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                    <path d="M12 2 3 7v6c0 5 3.5 8 9 9 5.5-1 9-4 9-9V7l-9-5z" fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </Box>
            <Text class="qa-header-title">{title}</Text>
        </Box>
        <Box class="qa-header-nav">
            <loop item="nav" :each="{navItems}">
                <Box class="qa-header-nav-item">
                    <Text class="qa-header-nav-text">{nav.label}</Text>
                </Box>
            </loop>
        </Box>
        <Box class="qa-header-search">
            <svg class="qa-header-search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" />
                <path d="m20 20-3.5-3.5" fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <input class="qa-header-search-input" type="text" placeholder="搜索问题、标签或用户" :value="keyword" @input="onSearchInput" />
        </Box>
        <Box class="qa-header-actions">
            <button class="qa-header-ask" type="button" @click="onAsk">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <Text class="qa-header-ask-text">提问</Text>
            </button>
            <Box class="qa-header-avatar">
                <Text class="qa-header-avatar-text">A</Text>
            </Box>
        </Box>
    </Box>
</Box>
</widget>

<script>
let title: utf8 = "羁绊问答"
let navItems: list = []
let mut keyword: utf8 = ""

micro onSearchInput(e: InputEvent) {
    keyword = e.target.value
    emit("search", { keyword: keyword })
}

micro onAsk() {
    emit("ask", {})
}
</script>
<style>
.qa-header {
    width: 100%;
    background: var(--sys-surface);
    border-bottom: 1px solid var(--sys-outline);
    box-shadow: var(--sys-shadow);
    position: sticky;
    top: 0;
    z-index: var(--ui-z-sticky);
}
.qa-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--ui-space-3) var(--ui-space-6);
    display: flex;
    align-items: center;
    gap: var(--ui-space-5);
}
.qa-header-brand {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    flex-shrink: 0;
}
.qa-header-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sys-primary);
}
.qa-header-title {
    font-size: var(--ui-fs-lg);
    font-weight: 600;
    color: var(--sys-on-bg);
}
.qa-header-nav {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    flex: 1;
    min-width: 0;
}
.qa-header-nav-item {
    padding: var(--ui-space-1) var(--ui-space-3);
    border-radius: var(--sys-radius-sm);
    cursor: pointer;
}
.qa-header-nav-text {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-secondary);
}
.qa-header-nav-item:hover .qa-header-nav-text {
    color: var(--sys-primary);
}
.qa-header-search {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    height: var(--ui-control-h-sm);
    padding: 0 var(--ui-space-3);
    background: var(--sys-surface-hover);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-full);
    width: 280px;
    max-width: 32vw;
}
.qa-header-search-icon {
    color: var(--sys-on-bg-tertiary);
    flex-shrink: 0;
}
.qa-header-search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    outline: none;
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg);
}
.qa-header-search-input::placeholder {
    color: var(--sys-on-bg-tertiary);
}
.qa-header-actions {
    display: flex;
    align-items: center;
    gap: var(--ui-space-3);
    flex-shrink: 0;
}
.qa-header-ask {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-space-1);
    height: var(--ui-control-h-sm);
    padding: 0 var(--ui-space-4);
    background: var(--sys-primary);
    color: var(--sys-on-primary);
    border: none;
    border-radius: var(--sys-radius-md);
    cursor: pointer;
    font-size: var(--ui-fs-sm);
    font-weight: 500;
    transition: background var(--ui-duration-1) var(--ui-easing);
}
.qa-header-ask:hover {
    background: var(--sys-primary-hover);
}
.qa-header-ask-text {
    color: var(--sys-on-primary);
    font-size: var(--ui-fs-sm);
    font-weight: 500;
}
.qa-header-avatar {
    width: var(--ui-control-h-sm);
    height: var(--ui-control-h-sm);
    border-radius: var(--sys-radius-full);
    background: var(--sys-primary-container);
    color: var(--sys-primary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}
.qa-header-avatar-text {
    font-size: var(--ui-fs-sm);
    font-weight: 600;
    color: var(--sys-primary);
}
@media (max-width: 720px) {
    .qa-header-nav {
        display: none;
    }
    .qa-header-search {
        width: 160px;
        max-width: 40vw;
    }
}
</style>
