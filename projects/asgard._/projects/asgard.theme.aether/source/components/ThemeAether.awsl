    --sys-radius-full: 9999px;
    --ui-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --ui-font-serif: Georgia, 'Times New Roman', serif;
    --ui-font-mono: 'SF Mono', 'JetBrains Mono', monospace;
    --ui-easing: cubic-bezier(0.2, 0.0, 0.0, 1.0);
