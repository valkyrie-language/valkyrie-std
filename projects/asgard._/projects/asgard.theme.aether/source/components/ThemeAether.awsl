    --sys-outline-focus: #09090b;
    --sys-shadow: 0 1px 2px rgba(0,0,0,0.04);
    --sys-shadow-lg: 0 4px 12px rgba(0,0,0,0.06);
    --sys-success: #16a34a;
    --sys-error: #dc2626;
    --sys-warning: #d97706;
    --sys-info: #2563eb;
    --sys-radius-sm: 4px;
