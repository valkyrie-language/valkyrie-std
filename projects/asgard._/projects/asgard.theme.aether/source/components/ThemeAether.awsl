<widget ThemeAether>
<Box @class="theme-aether-{mode}">
    <slot />
</Box>
</widget>

<script>
let mode: utf8 = "light"

micro setMode(m: utf8) {
    mode = m
    emit("modeChange", { mode: mode })
}
</script>
<style>
.theme-aether-light {
    --sys-bg: #ffffff;
    --sys-surface: #fafafa;
