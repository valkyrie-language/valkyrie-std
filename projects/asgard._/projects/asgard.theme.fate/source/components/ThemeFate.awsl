<widget ThemeFate>
<Box @class="theme-fate-{mode}">
    <slot />
</Box>
</widget>

<script>
let mode: utf8 = "light"

micro setMode(m: utf8) {
    mode = m
    emit("modeChange", { mode: mode })
}
</script>
