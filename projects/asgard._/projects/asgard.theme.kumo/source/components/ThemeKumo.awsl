    --sys-bg: #0f0f1a;
    --sys-surface: rgba(30, 30, 50, 0.6);
    --sys-surface-hover: rgba(40, 40, 65, 0.7);
    --sys-on-bg: #e0e4ff;
    --sys-on-surface: #e0e4ff;
    --sys-on-bg-secondary: #9094b8;
    --sys-on-bg-tertiary: #6a6e90;
