    --sys-on-primary: #ffffff;
    --sys-outline: rgba(255, 255, 255, 0.5);
    --sys-outline-focus: #6366f1;
    --sys-shadow: 0 2px 8px rgba(99, 102, 241, 0.08);
    --sys-shadow-lg: 0 8px 32px rgba(99, 102, 241, 0.12);
    --sys-success: #22c55e;
    --sys-error: #ef4444;
    --sys-warning: #f59e0b;
    --sys-info: #3b82f6;
    --sys-radius-sm: 12px;
    --sys-radius-md: 20px;
