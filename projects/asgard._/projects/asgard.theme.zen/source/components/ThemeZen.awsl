<widget ThemeZen>
<Box @class="theme-zen-{mode}">
    <slot />
</Box>
</widget>

<script>
let mode: utf8 = "light"

micro setMode(m: utf8) {
    mode = m
    emit("modeChange", { mode: mode })
}
</script>
<style>
.theme-zen-light {
    --sys-bg: #faf7f2;
