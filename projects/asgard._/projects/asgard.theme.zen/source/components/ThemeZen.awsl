    --sys-radius-full: 9999px;
    --ui-font-sans: 'Inter', -apple-system, sans-serif;
    --ui-font-serif: 'Literata', Georgia, serif;
    --ui-font-mono: 'SF Mono', monospace;
    --ui-easing: cubic-bezier(0.4, 0.0, 0.2, 1.0);
