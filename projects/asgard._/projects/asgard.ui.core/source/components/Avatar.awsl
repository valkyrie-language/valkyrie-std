<widget Avatar>
<Box @class="ui-avatar ui-avatar-{size} ui-avatar-{shape} {hasError || !src ? 'ui-avatar-fallback' : ''}">
    <if :condition="src &amp;&amp; !hasError">
        <img class="ui-avatar-img" :src="src" :alt="alt" @error="handleError" />
        <else />
        <Text class="ui-avatar-text">{fallbackText}</Text>
    </if>
</Box>
</widget>

<script>
let src: utf8 = ""
let alt: utf8 = ""
let size: utf8 = "md"
let shape: utf8 = "circle"
let fallback: utf8 = ""

let mut hasError: bool = false
let mut fallbackText: utf8 = ""

micro handleError() {
    hasError = true
    emit("error", {})
}

micro onMount() {
    if fallback != "" {
        fallbackText = fallback
    } else if (alt != "") {
    fallbackText = alt
}
}
</script>
<style>
.ui-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--sys-primary-container);
    color: var(--sys-primary);
    font-family: var(--ui-font-sans);
    font-weight: 600;
    flex-shrink: 0;
    user-select: none;
}
.ui-avatar-xs {
    width: 24px;
    height: 24px;
    font-size: var(--ui-fs-xs);
}
.ui-avatar-sm {
    width: 32px;
    height: 32px;
    font-size: var(--ui-fs-sm);
}
.ui-avatar-md {
    width: 40px;
    height: 40px;
    font-size: var(--ui-fs-base);
}
.ui-avatar-lg {
    width: 48px;
    height: 48px;
    font-size: var(--ui-fs-lg);
}
.ui-avatar-xl {
    width: 64px;
    height: 64px;
    font-size: var(--ui-fs-h3);
}
.ui-avatar-circle {
    border-radius: var(--sys-radius-full);
}
.ui-avatar-square {
    border-radius: var(--sys-radius-md);
}
.ui-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.ui-avatar-text {
    line-height: 1;
    text-transform: uppercase;
}
.ui-avatar-fallback {
    background: var(--sys-primary-container);
}
</style>
