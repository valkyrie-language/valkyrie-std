<widget Btn>
<button :disabled="disabled || loading" type="button" @class="ui-btn ui-btn-{variant} ui-btn-{size} {loading ? 'ui-btn-loading' : ''} {block ? 'ui-btn-block' : ''} {iconOnly ? 'ui-btn-icon-only' : ''}" @click="handleClick">
    <if :condition="loading">
        <svg class="ui-btn-spinner" viewBox="0 0 24 24" :width="spinnerSize" :height="spinnerSize">
            <path class="ui-btn-spinner-path" d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8" />
        </svg>
        <else />
    </if>
    <Text class="ui-btn-content">
        <slot />
    </Text>
</button>
</widget>

<script>
let variant: utf8 = "default"
let size: utf8 = "md"
let disabled: bool = false
let loading: bool = false
let block: bool = false
let iconOnly: bool = false
let spinnerSize: utf8 = "16"

micro handleClick() {
    if !disabled && !loading {
        emit("click", {})
    }
}

micro onMount() {
    if size == "xs" {
        spinnerSize = "12"
    } else if (size == "sm") {
    spinnerSize = "14"
} else if (size == "lg") {
spinnerSize = "20"
} else {
spinnerSize = "16"
}
}
</script>
<style>
.ui-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--ui-space-2);
    border: 1px solid transparent;
    border-radius: var(--sys-radius-md);
    font-family: var(--ui-font-sans);
    font-weight: 500;
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
    white-space: nowrap;
    user-select: none;
    outline: none;
    line-height: 1;
}
.ui-btn-xs {
    height: var(--ui-control-h-xs);
    padding: 0 var(--ui-control-px-xs);
    font-size: var(--ui-fs-xs);
}
.ui-btn-sm {
    height: var(--ui-control-h-sm);
    padding: 0 var(--ui-control-px-sm);
    font-size: var(--ui-fs-sm);
}
.ui-btn-md {
    height: var(--ui-control-h-md);
    padding: 0 var(--ui-control-px-md);
    font-size: var(--ui-fs-base);
}
.ui-btn-lg {
    height: var(--ui-control-h-lg);
    padding: 0 var(--ui-control-px-lg);
    font-size: var(--ui-fs-lg);
}
.ui-btn-default {
    background: var(--sys-surface);
    color: var(--sys-on-bg);
    border-color: var(--sys-outline);
}
.ui-btn-default:hover {
    background: var(--sys-surface-hover);
    border-color: var(--sys-outline-focus);
}
.ui-btn-primary {
    background: var(--sys-primary);
    color: var(--sys-on-primary);
    border-color: var(--sys-primary);
}
.ui-btn-primary:hover {
    background: var(--sys-primary-hover);
    border-color: var(--sys-primary-hover);
}
.ui-btn-secondary {
    background: var(--sys-primary-container);
    color: var(--sys-primary);
    border-color: transparent;
}
.ui-btn-secondary:hover {
    background: var(--sys-primary);
    color: var(--sys-on-primary);
}
.ui-btn-ghost {
    background: transparent;
    color: var(--sys-on-bg);
    border-color: transparent;
}
.ui-btn-ghost:hover {
    background: var(--sys-surface-hover);
}
.ui-btn-outline {
    background: transparent;
    color: var(--sys-on-bg);
    border-color: var(--sys-outline);
}
.ui-btn-outline:hover {
    background: var(--sys-surface-hover);
    border-color: var(--sys-outline-focus);
}
.ui-btn-error {
    background: var(--sys-error);
    color: var(--sys-on-primary);
    border-color: var(--sys-error);
}
.ui-btn-error:hover {
    opacity: 0.9;
}
.ui-btn-warning {
    background: var(--sys-warning);
    color: var(--sys-on-primary);
    border-color: var(--sys-warning);
}
.ui-btn-warning:hover {
    opacity: 0.9;
}
.ui-btn-success {
    background: var(--sys-success);
    color: var(--sys-on-primary);
    border-color: var(--sys-success);
}
.ui-btn-success:hover {
    opacity: 0.9;
}
.ui-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-btn-loading {
    opacity: 0.7;
    pointer-events: none;
}
.ui-btn-icon-only {
    padding: 0;
    aspect-ratio: 1;
}
.ui-btn-icon-only.ui-btn-xs {
    width: var(--ui-control-h-xs);
}
.ui-btn-icon-only.ui-btn-sm {
    width: var(--ui-control-h-sm);
}
.ui-btn-icon-only.ui-btn-md {
    width: var(--ui-control-h-md);
}
.ui-btn-icon-only.ui-btn-lg {
    width: var(--ui-control-h-lg);
}
.ui-btn-block {
    display: flex;
    width: 100%;
}
.ui-btn-spinner {
    animation: ui-btn-spin 0.8s linear infinite;
    flex-shrink: 0;
}
.ui-btn-spinner-path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
}
@keyframes ui-btn-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
.ui-btn:focus-visible {
    box-shadow: 0 0 0 2px var(--sys-bg), 0 0 0 4px var(--sys-outline-focus);
}
.ui-btn-content {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-space-2);
}

</style>
