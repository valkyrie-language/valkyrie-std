<widget Card>
<Box @class="ui-card ui-card-{variant} ui-card-pad-{padding} {hoverable ? 'ui-card-hoverable' : ''}">
    <slot name="header" />
    <if :condition="title">
        <Box class="ui-card-header">
            <Box class="ui-card-title">{title}</Box>
            <if :condition="subtitle">
                <Box class="ui-card-subtitle">{subtitle}</Box>
                <else />
            </if>
        </Box>
        <else />
    </if>
    <Box class="ui-card-body">
        <slot />
    </Box>
    <Box class="ui-card-footer">
        <slot name="footer" />
    </Box>
</Box>
</widget>

<script>
let variant: utf8 = "elevated"
let title: utf8 = ""
let subtitle: utf8 = ""
let hoverable: bool = false
let padding: utf8 = "md"
</script>
<style>
.ui-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--sys-radius-lg);
    background: var(--sys-surface);
    transition: all var(--ui-duration-1) var(--ui-easing);
    font-family: var(--ui-font-sans);
}
.ui-card-elevated {
    box-shadow: var(--sys-shadow);
}
.ui-card-outlined {
    border: 1px solid var(--sys-outline);
}
.ui-card-filled {
    background: var(--sys-surface-hover);
}
.ui-card-hoverable:hover {
    box-shadow: var(--sys-shadow-lg);
    transform: translateY(-2px);
}
.ui-card-pad-none {
    padding: 0;
}
.ui-card-pad-sm {
    padding: var(--ui-space-3);
}
.ui-card-pad-md {
    padding: var(--ui-space-5);
}
.ui-card-pad-lg {
    padding: var(--ui-space-6);
}
.ui-card-header {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-1);
    margin-bottom: var(--ui-space-4);
}
.ui-card-title {
    font-size: var(--ui-fs-lg);
    font-weight: 600;
    color: var(--sys-on-bg);
    line-height: var(--ui-lh-tight);
}
.ui-card-subtitle {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-secondary);
}
.ui-card-body {
    flex: 1;
    color: var(--sys-on-bg);
    font-size: var(--ui-fs-base);
    line-height: var(--ui-lh-normal);
}
.ui-card-footer {
    margin-top: var(--ui-space-4);
    padding-top: var(--ui-space-3);
    border-top: 1px solid var(--sys-outline);
}
.ui-card-footer:empty {
    display: none;
}
</style>
