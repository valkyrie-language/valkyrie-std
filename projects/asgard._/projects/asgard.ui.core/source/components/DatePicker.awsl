<widget DatePicker>
<Box @class="ui-date-picker-wrapper" @click="toggleOpen">
    <Box @class="ui-date-picker-trigger ui-date-picker-{size} {disabled ? 'ui-date-picker-disabled' : ''} {isOpen ? 'ui-date-picker-trigger-open' : ''}">
        <Text @class="ui-date-picker-icon">
            <svg @class="ui-date-picker-icon-svg" viewBox="0 0 24 24" width="16" height="16">
                <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
            </svg>
        </Text>
        <Text @class="ui-date-picker-value {selectedDate == '' ? 'ui-date-picker-placeholder' : ''}">
            <if selectedDate == ''>
                {placeholder}
                <else/>
                {selectedDate}
            </if>
        </Text>
        <if clearable && selectedDate != '' && !disabled>
            <Text @class="ui-date-picker-clear" @click="clearDate">
                <svg @class="ui-date-picker-clear-svg" viewBox="0 0 24 24" width="14" height="14">
                    <path d="M18 6 6 18M6 6l12 12" />
                </svg>
            </Text>
            <else/>
        </if>
    </Box>
    <if isOpen && !disabled>
        <Box @class="ui-date-picker-dropdown" @click="stopPropagation">
            <Box @class="ui-date-picker-header">
                <button @class="ui-date-picker-nav-btn" @click="prevMonth" type="button">
                    <svg @class="ui-date-picker-nav-svg" viewBox="0 0 24 24" width="16" height="16">
                        <path d="m15 18-6-6 6-6" />
                    </svg>
                </button>
                <Text @class="ui-date-picker-title">{monthLabel} {viewYear}</Text>
                <button @class="ui-date-picker-nav-btn" @click="nextMonth" type="button">
                    <svg @class="ui-date-picker-nav-svg" viewBox="0 0 24 24" width="16" height="16">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </button>
            </Box>
            <Box @class="ui-date-picker-weekdays">
                <loop wd in {weekdays}>
                    <Text @class="ui-date-picker-weekday">{wd}</Text>
                </loop>
            </Box>
            <Box @class="ui-date-picker-grid">
                <loop cell in {calendarCells}>
                    <Box
                        @class="ui-date-picker-cell {cell.isCurrentMonth ? '' : 'ui-date-picker-cell-other'} {cell.dateStr == selectedDate ? 'ui-date-picker-cell-selected' : ''} {cell.isToday ? 'ui-date-picker-cell-today' : ''}"
                        @click="selectDate(cell)"
                    >
                        <Text @class="ui-date-picker-day">{cell.day}</Text>
                    </Box>
                </loop>
            </Box>
        </Box>
        <else/>
    </if>
</Box>
</widget>

<script>
let value: utf8 = ""
let placeholder: utf8 = "Select date"
let format: utf8 = "YYYY-MM-DD"
let size: utf8 = "md"
let disabled: bool = false
let clearable: bool = true

let mut isOpen: bool = false
let mut viewYear: i32 = 2024
let mut viewMonth: i32 = 1
let mut selectedDate: utf8 = ""

let weekdays: list = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"]

micro toggleOpen() {
    if disabled {
        return
    }
isOpen = !isOpen
}

micro stopPropagation(e) {
    e.stopPropagation()
}

micro clearDate(e) {
    e.stopPropagation()
    selectedDate = ""
    emit("change", { value: "" })
}

micro prevMonth() {
    if viewMonth == 1 {
        viewMonth = 12
        viewYear = viewYear - 1
    } else {
    viewMonth = viewMonth - 1
}
}

micro nextMonth() {
    if viewMonth == 12 {
        viewMonth = 1
        viewYear = viewYear + 1
    } else {
    viewMonth = viewMonth + 1
}
}

micro monthLabel() {
    let names: list = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    return names[viewMonth - 1]
}

micro calendarCells() {
    let cells: list = []
    let firstDay: i32 = dayOfWeek(viewYear, viewMonth, 1)
    let daysInMonth: i32 = daysInMonth(viewYear, viewMonth)
    let prevDays: i32 = daysInPrevMonth()
    let i: i32 = 0
    while i < firstDay {
        let day: i32 = prevDays - firstDay + 1 + i
        let prevMonth: i32 = viewMonth - 1
        let prevYear: i32 = viewYear
        if prevMonth < 1 {
            prevMonth = 12
            prevYear = viewYear - 1
        }
    cells = push(cells, makeCell(prevYear, prevMonth, day, false))
    i = i + 1
}
i = 1
while i <= daysInMonth {
    cells = push(cells, makeCell(viewYear, viewMonth, i, true))
    i = i + 1
}
let remaining: i32 = 42 - cells.length
i = 1
while i <= remaining {
    let nextMonth: i32 = viewMonth + 1
    let nextYear: i32 = viewYear
    if nextMonth > 12 {
        nextMonth = 1
        nextYear = viewYear + 1
    }
cells = push(cells, makeCell(nextYear, nextMonth, i, false))
i = i + 1
}
return cells
}

micro daysInPrevMonth() {
    let prevMonth: i32 = viewMonth - 1
    let prevYear: i32 = viewYear
    if prevMonth < 1 {
        prevMonth = 12
        prevYear = viewYear - 1
    }
return daysInMonth(prevYear, prevMonth)
}

micro makeCell(year: i32, month: i32, day: i32, isCurrentMonth: bool) {
    let dateStr: utf8 = pad(year) + "-" + pad2(month) + "-" + pad2(day)
    let todayStr: utf8 = today()
    return {
        year: year,
        month: month,
        day: day,
        isCurrentMonth: isCurrentMonth,
        dateStr: dateStr,
        isToday: dateStr == todayStr
    }
}

micro selectDate(cell) {
    if !cell.isCurrentMonth {
        viewYear = cell.year
        viewMonth = cell.month
    }
selectedDate = cell.dateStr
isOpen = false
emit("change", { value: selectedDate })
}

micro onMount() {
    if value != "" {
        selectedDate = value
        let parts: list = split(value, "-")
        if parts.length >= 2 {
            viewYear = toI32(parts[0])
            viewMonth = toI32(parts[1])
        }
}
}
</script>

<style>
.ui-date-picker-wrapper {
    position: relative;
    display: inline-block;
    width: 100%;
    font-family: var(--ui-font-sans);
}
.ui-date-picker-trigger {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-md);
    background: var(--sys-surface);
    padding: 0 var(--ui-space-3);
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-date-picker-trigger:hover {
    border-color: var(--sys-outline-focus);
}
.ui-date-picker-trigger-open {
    border-color: var(--sys-outline-focus);
    box-shadow: 0 0 0 3px var(--sys-primary-container);
}
.ui-date-picker-xs {
    height: var(--ui-control-h-xs);
    font-size: var(--ui-fs-xs);
}
.ui-date-picker-sm {
    height: var(--ui-control-h-sm);
    font-size: var(--ui-fs-sm);
}
.ui-date-picker-md {
    height: var(--ui-control-h-md);
    font-size: var(--ui-fs-base);
}
.ui-date-picker-lg {
    height: var(--ui-control-h-lg);
    font-size: var(--ui-fs-lg);
}
.ui-date-picker-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-date-picker-icon {
    display: flex;
    align-items: center;
    color: var(--sys-on-bg-tertiary);
    flex-shrink: 0;
}
.ui-date-picker-icon-svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.ui-date-picker-value {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--sys-on-bg);
}
.ui-date-picker-placeholder {
    color: var(--sys-on-bg-tertiary);
}
.ui-date-picker-clear {
    display: flex;
    align-items: center;
    color: var(--sys-on-bg-tertiary);
    cursor: pointer;
    flex-shrink: 0;
}
.ui-date-picker-clear:hover {
    color: var(--sys-on-bg);
}
.ui-date-picker-clear-svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.ui-date-picker-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    z-index: var(--ui-z-dropdown);
    background: var(--sys-surface);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-md);
    box-shadow: var(--sys-shadow-lg);
    padding: var(--ui-space-3);
    width: 280px;
}
.ui-date-picker-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--ui-space-2);
}
.ui-date-picker-nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-sm);
    background: var(--sys-surface);
    color: var(--sys-on-bg);
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-date-picker-nav-btn:hover {
    border-color: var(--sys-outline-focus);
    background: var(--sys-surface-hover);
}
.ui-date-picker-nav-svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.ui-date-picker-title {
    font-size: var(--ui-fs-sm);
    font-weight: 600;
    color: var(--sys-on-bg);
}
.ui-date-picker-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--ui-space-1);
    margin-bottom: var(--ui-space-1);
}
.ui-date-picker-weekday {
    text-align: center;
    font-size: var(--ui-fs-xs);
    font-weight: 600;
    color: var(--sys-on-bg-tertiary);
    padding: var(--ui-space-1) 0;
}
.ui-date-picker-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--ui-space-1);
}
.ui-date-picker-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border-radius: var(--sys-radius-sm);
    cursor: pointer;
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg);
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-date-picker-cell:hover {
    background: var(--sys-surface-hover);
}
.ui-date-picker-cell-other {
    color: var(--sys-on-bg-tertiary);
}
.ui-date-picker-cell-today {
    border: 1px solid var(--sys-primary);
    color: var(--sys-primary);
}
.ui-date-picker-cell-selected {
    background: var(--sys-primary);
    color: var(--sys-on-primary);
}
.ui-date-picker-cell-selected:hover {
    background: var(--sys-primary-hover);
}
.ui-date-picker-day {
    line-height: 1;
}
</style>
