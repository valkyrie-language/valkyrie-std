<widget Descriptions>
<Box @class="ui-desc {bordered ? 'ui-desc-bordered' : ''}">
    <if :condition="title">
        <Box class="ui-desc-title">{title}</Box>
        <else />
    </if>
    <Box class="ui-desc-body" :style="gridStyle">
        <loop item="item" :each="{items}">
            <Box @class="ui-desc-item {bordered ? 'ui-desc-item-bordered' : ''}">
                <Box class="ui-desc-label">{item.label}</Box>
                <Box class="ui-desc-value">{item.value}</Box>
            </Box>
        </loop>
    </Box>
</Box>
</widget>

<script>
let items: list = []
let column: utf8 = "1"
let bordered: bool = true
let title: utf8 = ""

let mut gridStyle: utf8 = ""

micro onMount() {
    gridStyle = "grid-template-columns: repeat(" + column + ", minmax(0, 1fr));"
}
</script>
<style>
.ui-desc {
    font-family: var(--ui-font-sans);
    background: var(--sys-surface);
    border-radius: var(--sys-radius-md);
}
.ui-desc-bordered {
    border: 1px solid var(--sys-outline);
}
.ui-desc-title {
    padding: var(--ui-space-3) var(--ui-space-4);
    font-size: var(--ui-fs-base);
    font-weight: 600;
    color: var(--sys-on-bg);
    border-bottom: 1px solid var(--sys-outline);
}
.ui-desc-body {
    display: grid;
    gap: 0;
}
.ui-desc-item {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-1);
    padding: var(--ui-space-3) var(--ui-space-4);
}
.ui-desc-item-bordered {
    border-bottom: 1px solid var(--sys-outline);
    border-right: 1px solid var(--sys-outline);
}
.ui-desc-label {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-secondary);
}
.ui-desc-value {
    font-size: var(--ui-fs-base);
    color: var(--sys-on-bg);
    font-weight: 500;
}
</style>
