<widget Image>
<Box :style="radiusStyle" @class="ui-image ui-image-fit-{fit} {hasError ? 'ui-image-error' : ''} {loaded ? 'ui-image-loaded' : ''}">
    <if :condition="hasError">
        <Box class="ui-image-fallback">
            <if :condition="fallback">
                <Text class="ui-image-fallback-text">{fallback}</Text>
                <else />
                <svg class="ui-image-broken" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
                    <path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z M3.3 7 12 12l8.7-5 M12 22V12" />
                </svg>
            </if>
        </Box>
        <else />
        <if :condition="!loaded">
            <Box class="ui-image-placeholder">
                <if :condition="placeholder">
                    <Text class="ui-image-placeholder-text">{placeholder}</Text>
                    <else />
                    <Box class="ui-image-shimmer"></Box>
                </if>
            </Box>
            <else />
        </if>
        <img class="ui-image-img" :src="src" :alt="alt" @load="handleLoad" @error="handleError" />
    </if>
</Box>
</widget>

<script>
let src: utf8 = ""
let alt: utf8 = ""
let fit: utf8 = "cover"
let radius: utf8 = ""
let placeholder: utf8 = ""
let fallback: utf8 = ""
let preview: bool = false

let mut loaded: bool = false
let mut hasError: bool = false
let mut radiusStyle: utf8 = ""

micro onMount() {
    if radius != "" {
        radiusStyle = "border-radius: " + radius + ";"
    }
if src == "" {
    hasError = true
}
}

micro handleLoad() {
    loaded = true
    emit("load", {})
}

micro handleError() {
    hasError = true
    loaded = false
    emit("error", {})
}
</script>
<style>
.ui-image {
    position: relative;
    display: inline-block;
    overflow: hidden;
    background: var(--sys-surface-hover);
    max-width: 100%;
}
.ui-image-fit-cover .ui-image-img {
    object-fit: cover;
}
.ui-image-fit-contain .ui-image-img {
    object-fit: contain;
}
.ui-image-fit-fill .ui-image-img {
    object-fit: fill;
}
.ui-image-fit-none .ui-image-img {
    object-fit: none;
}
.ui-image-img {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--ui-duration-2) var(--ui-easing);
}
.ui-image-loaded .ui-image-img {
    opacity: 1;
}
.ui-image-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--sys-surface-hover);
}
.ui-image-placeholder-text {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-tertiary);
}
.ui-image-shimmer {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--sys-surface-hover) 0%, var(--sys-surface) 50%, var(--sys-surface-hover) 100%);
    background-size: 200% 100%;
    animation: ui-image-shimmer 1.6s infinite;
}
@keyframes ui-image-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
}
.ui-image-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 80px;
    color: var(--sys-on-bg-tertiary);
}
.ui-image-fallback-text {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-tertiary);
}
.ui-image-broken {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}
</style>
