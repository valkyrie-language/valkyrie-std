                </svg>
                <if :condition="text != &quot;&quot;">
                    <Text @class="ui-loading-overlay-text">{text}</Text>
                    <else />
                </if>
            </Box>
        </Box>
        <else />
    </if>
</Box>
</widget>

<script>
let visible: bool = false
let text: utf8 = "Loading..."
</script>
