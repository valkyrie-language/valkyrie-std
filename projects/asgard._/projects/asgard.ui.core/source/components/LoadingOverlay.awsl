<widget LoadingOverlay>
<Box @class="ui-loading-overlay-wrapper">
    <slot />
    <if :condition="visible">
        <Box @class="ui-loading-overlay">
            <Box @class="ui-loading-overlay-backdrop"></Box>
            <Box @class="ui-loading-overlay-content">
                <svg @class="ui-loading-overlay-spinner" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
