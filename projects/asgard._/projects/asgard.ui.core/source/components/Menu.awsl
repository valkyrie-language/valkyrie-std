<widget Menu>
<Box @class="ui-menu ui-menu-{mode} {collapsed ? 'ui-menu-collapsed' : ''}">
    <loop item="item" :each="{items}">
        <Box @class="ui-menu-item-wrap">
            <Box @class="ui-menu-item {selectedKey == item.key ? 'ui-menu-item-selected' : ''} {item.disabled ? 'ui-menu-item-disabled' : ''}" @click="handleClick(item)">
                <if :condition="item.icon != &quot;&quot;">
                    <svg @class="ui-menu-item-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                        <path :d="item.icon" />
                    </svg>
                    <else />
                </if>
                <if :condition="!collapsed">
                    <Text @class="ui-menu-item-label">{item.label}</Text>
                    <else />
                </if>
                <if :condition="item.children &amp;&amp; !collapsed">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" @class="ui-menu-arrow {openKeys.indexOf(item.key) >= 0 ? 'ui-menu-arrow-open' : ''}">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                    <else />
                </if>
            </Box>
            <if :condition="item.children &amp;&amp; openKeys.indexOf(item.key)">
                = 0>
                <Box @class="ui-menu-submenu">
                    <loop item="child" :each="{item.children}">
                        <Box @class="ui-menu-item ui-menu-submenu-item {selectedKey == child.key ? 'ui-menu-item-selected' : ''} {child.disabled ? 'ui-menu-item-disabled' : ''}" @click="handleClick(child)">
                            <if :condition="child.icon != &quot;&quot;">
                                <svg @class="ui-menu-item-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                                    <path :d="child.icon" />
                                </svg>
                                <else />
                            </if>
                            <Text @class="ui-menu-item-label">{child.label}</Text>
                        </Box>
                    </loop>
                </Box>
                <else />
            </if>
        </Box>
    </loop>
</Box>
</widget>

<script>
let items: list = []
let mode: utf8 = "vertical"
let selectedKey: utf8 = ""
let collapsed: bool = false
let mut openKeys: list = []

micro handleClick(item) {
    if item.disabled { return }
    if item.children {
        if openKeys.indexOf(item.key) >= 0 {
            openKeys = openKeys.filter(function(k) { return k != item.key })
        } else {
        openKeys = openKeys.concat([item.key])
    }
} else {
emit("select", {key: item.key})
}
}
</script>
<style>
.ui-menu {
    display: flex;
    font-family: var(--ui-font-sans);
    font-size: var(--ui-fs-sm);
    background: var(--sys-surface);
}
.ui-menu-vertical, .ui-menu-inline {
    flex-direction: column;
    padding: var(--ui-space-2);
    gap: var(--ui-space-1);
    min-width: 200px;
}
.ui-menu-horizontal {
    flex-direction: row;
    align-items: center;
    padding: 0 var(--ui-space-2);
    gap: var(--ui-space-1);
}
.ui-menu-collapsed {
    min-width: auto;
}
.ui-menu-item-wrap {
    display: flex;
    flex-direction: column;
}
.ui-menu-horizontal .ui-menu-item-wrap {
    flex-direction: column;
}
.ui-menu-item {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    padding: 0 var(--ui-space-3);
    height: var(--ui-control-h-md);
    border-radius: var(--sys-radius-md);
    color: var(--sys-on-bg-secondary);
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
    white-space: nowrap;
}
.ui-menu-item:hover:not(.ui-menu-item-disabled) {
    background: var(--sys-surface-hover);
    color: var(--sys-on-bg);
}
.ui-menu-item-selected {
    background: var(--sys-primary-container);
    color: var(--sys-primary);
}
.ui-menu-item-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-menu-item-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
}
.ui-menu-item-label {
    flex: 1;
}
.ui-menu-collapsed .ui-menu-item {
    justify-content: center;
    padding: 0;
    width: var(--ui-control-h-md);
}
.ui-menu-arrow {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
    transition: transform var(--ui-duration-1) var(--ui-easing);
}
.ui-menu-arrow-open {
    transform: rotate(180deg);
}
.ui-menu-submenu {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-1);
    padding-left: var(--ui-space-6);
    margin-top: var(--ui-space-1);
}
.ui-menu-inline .ui-menu-submenu {
    padding-left: var(--ui-space-6);
}
.ui-menu-horizontal .ui-menu-submenu {
    position: absolute;
    top: 100%;
    left: 0;
    background: var(--sys-surface);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-md);
    box-shadow: var(--sys-shadow-lg);
    padding: var(--ui-space-2);
    z-index: var(--ui-z-dropdown);
}
.ui-menu-horizontal .ui-menu-item-wrap {
    position: relative;
}
</style>
