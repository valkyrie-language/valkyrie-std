<widget PasswordInput>
<Box class="ui-password-wrapper">
    <if :condition="label">
        <label class="ui-password-label">{label}</label>
        <else />
    </if>
    <Box @class="ui-password-box ui-password-{size} {error ? 'ui-password-error' : ''} {disabled ? 'ui-password-disabled' : ''}">
        <input class="ui-password-field" :type="showPassword ? 'text' : 'password'" :placeholder="placeholder" :value="value" :disabled="disabled" @input="handleInput" @focus="handleFocus" @blur="handleBlur" />
        <button class="ui-password-toggle" type="button" :disabled="disabled" tabindex="-1" @click="togglePassword">
            <if :condition="showPassword">
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path class="ui-password-icon" d="M9.9 4.2A9.1 9.1 0 0 1 12 4c7 0 10 8 10 8a13.2 13.2 0 0 1-1.7 2.7M6.6 6.6A13.2 13.2 0 0 0 2 12s3 7 10 7a9.1 9.1 0 0 0 5.4-1.7M6.6 6.6 3 3M6.6 6.6 9.9 9.9M17.4 17.4 21 21M14.1 14.1a3 3 0 0 1-4.2-4.2" />
                </svg>
                <else />
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path class="ui-password-icon" d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
                </svg>
            </if>
        </button>
    </Box>
    <if :condition="showStrength">
        <Box class="ui-password-strength">
            <Box @class="ui-password-strength-bar ui-password-strength-{strengthLevel}"></Box>
            <Text class="ui-password-strength-label">{strengthText}</Text>
        </Box>
        <else />
    </if>
    <if :condition="error">
        <Text class="ui-password-error-text">{error}</Text>
        <else />
    </if>
</Box>
</widget>

<script>
let mut value: utf8 = ""
let placeholder: utf8 = ""
let size: utf8 = "md"
let disabled: bool = false
let label: utf8 = ""
let error: utf8 = ""
let showStrength: bool = false
let mut showPassword: bool = false
let mut strengthLevel: utf8 = "weak"
let mut strengthText: utf8 = "Weak"

micro togglePassword() {
    if disabled { return }
    showPassword = !showPassword
}

micro handleInput(e: InputEvent) {
    value = e.target.value
    updateStrength(value)
    emit("input", { value: value })
}

micro handleFocus() {
    emit("focus", {})
}

micro handleBlur() {
    emit("blur", {})
}

micro updateStrength(val: utf8) {
    let len: i32 = val.length
    if len == 0 {
        strengthLevel = "weak"
        strengthText = "Weak"
    } else if (len < 6) {
    strengthLevel = "weak"
    strengthText = "Weak"
} else if (len < 10) {
strengthLevel = "medium"
strengthText = "Medium"
} else {
strengthLevel = "strong"
strengthText = "Strong"
}
}
</script>
<style>
.ui-password-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-1);
}
.ui-password-label {
    font-size: var(--ui-fs-sm);
    color: var(--sys-on-bg-secondary);
    font-weight: 500;
}
.ui-password-box {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-md);
    background: var(--sys-surface);
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-password-box:hover {
    border-color: var(--sys-outline-focus);
}
.ui-password-box:focus-within {
    border-color: var(--sys-outline-focus);
    box-shadow: 0 0 0 3px var(--sys-primary-container);
}
.ui-password-xs {
    height: var(--ui-control-h-xs);
    padding: 0 var(--ui-space-2);
}
.ui-password-xs .ui-password-field {
    font-size: var(--ui-fs-xs);
}
.ui-password-sm {
    height: var(--ui-control-h-sm);
    padding: 0 var(--ui-space-3);
}
.ui-password-sm .ui-password-field {
    font-size: var(--ui-fs-sm);
}
.ui-password-md {
    height: var(--ui-control-h-md);
    padding: 0 var(--ui-space-4);
}
.ui-password-md .ui-password-field {
    font-size: var(--ui-fs-base);
}
.ui-password-lg {
    height: var(--ui-control-h-lg);
    padding: 0 var(--ui-space-5);
}
.ui-password-lg .ui-password-field {
    font-size: var(--ui-fs-lg);
}
.ui-password-field {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: var(--sys-on-bg);
    font-family: var(--ui-font-sans);
    min-width: 0;
}
.ui-password-field::placeholder {
    color: var(--sys-on-bg-tertiary);
}
.ui-password-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--sys-on-bg-secondary);
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-password-toggle:hover {
    color: var(--sys-on-bg);
}
.ui-password-toggle[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-password-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
.ui-password-strength {
    display: flex;
    align-items: center;
    gap: var(--ui-space-2);
}
.ui-password-strength-bar {
    height: var(--ui-space-1);
    flex: 1;
    border-radius: var(--sys-radius-full);
    background: var(--sys-surface-hover);
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-password-strength-weak .ui-password-strength-bar,
.ui-password-strength-bar.ui-password-strength-weak {
    background: var(--sys-error);
    width: 33%;
}
.ui-password-strength-medium .ui-password-strength-bar,
.ui-password-strength-bar.ui-password-strength-medium {
    background: var(--sys-warning);
    width: 66%;
}
.ui-password-strength-strong .ui-password-strength-bar,
.ui-password-strength-bar.ui-password-strength-strong {
    background: var(--sys-success);
    width: 100%;
}
.ui-password-strength-label {
    font-size: var(--ui-fs-xs);
    color: var(--sys-on-bg-tertiary);
    flex-shrink: 0;
}
.ui-password-error .ui-password-box {
    border-color: var(--sys-error);
}
.ui-password-error-text {
    font-size: var(--ui-fs-xs);
    color: var(--sys-error);
}
.ui-password-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-password-disabled .ui-password-field {
    cursor: not-allowed;
}

</style>
