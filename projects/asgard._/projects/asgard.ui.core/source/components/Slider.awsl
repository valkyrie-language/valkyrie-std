<widget Slider>
<Box @class="ui-slider ui-slider-{orientation} {disabled ? 'ui-slider-disabled' : ''}">
    <input class="ui-slider-input" type="range" :value="value" :min="min" :max="max" :step="step" :disabled="disabled" @input="handleInput" @change="handleChange" />
</Box>
</widget>

<script>
let mut value: utf8 = "0"
let min: utf8 = "0"
let max: utf8 = "100"
let step: utf8 = "1"
let disabled: bool = false
let orientation: utf8 = "horizontal"

micro handleInput(e: InputEvent) {
    value = e.target.value
    emit("input", { value: value })
}

micro handleChange(e: InputEvent) {
    value = e.target.value
    emit("change", { value: value })
}
</script>
<style>
.ui-slider {
    display: flex;
    align-items: center;
    font-family: var(--ui-font-sans);
}
.ui-slider-horizontal {
    width: 100%;
}
.ui-slider-vertical {
    height: 100%;
    flex-direction: column;
    justify-content: center;
}
.ui-slider-input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: var(--ui-space-1);
    border-radius: var(--sys-radius-full);
    background: var(--sys-surface-hover);
    outline: none;
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-slider-vertical .ui-slider-input {
    width: var(--ui-space-1);
    height: 100%;
    writing-mode: vertical-lr;
    direction: rtl;
}
.ui-slider-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: var(--ui-space-4);
    height: var(--ui-space-4);
    border-radius: var(--sys-radius-full);
    background: var(--sys-primary);
    border: 2px solid var(--sys-bg);
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
    box-shadow: var(--sys-shadow);
}
.ui-slider-input::-webkit-slider-thumb:hover {
    background: var(--sys-primary-hover);
    transform: scale(1.1);
}
.ui-slider-input::-moz-range-thumb {
    width: var(--ui-space-4);
    height: var(--ui-space-4);
    border-radius: var(--sys-radius-full);
    background: var(--sys-primary);
    border: 2px solid var(--sys-bg);
    cursor: pointer;
    transition: all var(--ui-duration-1) var(--ui-easing);
    box-shadow: var(--sys-shadow);
}
.ui-slider-input::-moz-range-thumb:hover {
    background: var(--sys-primary-hover);
    transform: scale(1.1);
}
.ui-slider-input:focus-visible {
    box-shadow: 0 0 0 2px var(--sys-bg), 0 0 0 4px var(--sys-outline-focus);
}
.ui-slider-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-slider-disabled .ui-slider-input {
    cursor: not-allowed;
    pointer-events: none;
}

</style>
