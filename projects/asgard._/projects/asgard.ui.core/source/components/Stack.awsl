<widget Stack>
<Box @class="ui-stack ui-stack-{direction} ui-stack-gap-{gap} ui-stack-align-{align} ui-stack-justify-{justify} {wrap ? 'ui-stack-wrap' : ''}">
    <slot />
</Box>
</widget>

<script>
let direction: utf8 = "column"
let gap: utf8 = "4"
let align: utf8 = "stretch"
let justify: utf8 = "start"
let wrap: bool = false
</script>
<style>
.ui-stack {
    display: flex;
    box-sizing: border-box;
}
