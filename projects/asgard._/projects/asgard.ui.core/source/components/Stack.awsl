    flex-direction: column;
}
.ui-stack-row {
    flex-direction: row;
}
.ui-stack-gap-1 { gap: var(--ui-space-1); }
.ui-stack-gap-2 { gap: var(--ui-space-2); }
.ui-stack-gap-3 { gap: var(--ui-space-3); }
.ui-stack-gap-4 { gap: var(--ui-space-4); }
.ui-stack-gap-5 { gap: var(--ui-space-5); }
.ui-stack-gap-6 { gap: var(--ui-space-6); }
.ui-stack-gap-8 { gap: var(--ui-space-8); }
.ui-stack-gap-10 { gap: var(--ui-space-10); }
.ui-stack-gap-12 { gap: var(--ui-space-12); }
.ui-stack-align-start { align-items: flex-start; }
.ui-stack-align-center { align-items: center; }
.ui-stack-align-end { align-items: flex-end; }
.ui-stack-align-stretch { align-items: stretch; }
