<widget Switch>
<label @class="ui-switch ui-switch-{size} {disabled ? 'ui-switch-disabled' : ''} {loading ? 'ui-switch-loading' : ''}">
    <Text @class="ui-switch-track {is_checked ? 'ui-switch-on' : ''}">
        <input class="ui-switch-input" type="checkbox" :checked="is_checked" :disabled="disabled" @change="toggle" />
        <Text class="ui-switch-thumb"></Text>
        <if :condition="loading">
            <svg class="ui-switch-spinner" viewBox="0 0 24 24" width="12" height="12">
                <path class="ui-switch-spinner-path" d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4M4.9 19.1l2.8-2.8M16.3 7.7l2.8-2.8" />
            </svg>
            <else />
        </if>
    </Text>
    <if :condition="label">
        <Text class="ui-switch-label">{label}</Text>
        <else />
    </if>
</label>
</widget>

<script>
let unused = 0;

[property]
let checked: bool = false

[property]
let disabled: bool = false

[property]
let size: utf8 = "md"

[property]
let loading: bool = false

[property]
let label: utf8 = ""

let mut is_checked: bool = false

[event]
micro change(checked: bool) { }

micro toggle() {
    if disabled || loading { return }
    is_checked = !is_checked
    emit(change, is_checked)
}

micro on_mount() {
    is_checked = checked
}
</script>
<style>
.ui-switch {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-space-2);
    cursor: pointer;
    user-select: none;
    font-family: var(--ui-font-sans);
    color: var(--sys-on-bg);
}
.ui-switch-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
}
.ui-switch-track {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 2.75rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: var(--sys-surface-variant);
    transition: background 0.2s ease;
}
.ui-switch-on {
    background: var(--sys-primary);
}
.ui-switch-thumb {
    position: absolute;
    left: 0.125rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    background: var(--sys-on-primary);
    transition: transform 0.2s ease;
}
.ui-switch-on .ui-switch-thumb {
    transform: translateX(1.25rem);
}
.ui-switch-disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
.ui-switch-label {
    font-size: var(--ui-text-sm);
}
.ui-switch-spinner {
    position: absolute;
    inset: 0;
    margin: auto;
    animation: ui-switch-spin 0.8s linear infinite;
}
@keyframes ui-switch-spin {
    to { transform: rotate(360deg); }
}
</style>
