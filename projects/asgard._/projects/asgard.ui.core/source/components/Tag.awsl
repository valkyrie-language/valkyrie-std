    font-size: var(--ui-fs-sm);
}
.ui-tag-lg {
    height: 28px;
    padding: 0 var(--ui-space-3);
    font-size: var(--ui-fs-base);
}
.ui-tag-default {
    background: var(--sys-surface);
    color: var(--sys-on-bg);
    border-color: var(--sys-outline);
}
.ui-tag-primary {
    background: var(--sys-primary-container);
    color: var(--sys-primary);
    border-color: transparent;
}
.ui-tag-success {
    background: var(--sys-success);
    color: var(--sys-on-primary);
    border-color: transparent;
}
.ui-tag-error {
    background: var(--sys-error);
    color: var(--sys-on-primary);
    border-color: transparent;
}
.ui-tag-warning {
    background: var(--sys-warning);
    color: var(--sys-on-primary);
    border-color: transparent;
}
.ui-tag-info {
    background: var(--sys-info);
    color: var(--sys-on-primary);
    border-color: transparent;
}
.ui-tag-content {
    display: inline-flex;
    align-items: center;
}
.ui-tag-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    color: currentColor;
    opacity: 0.7;
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-tag-close:hover {
    opacity: 1;
}
.ui-tag-close svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}
</style>
