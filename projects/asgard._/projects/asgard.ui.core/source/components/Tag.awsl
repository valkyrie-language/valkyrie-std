<widget Tag>
<Text @class="ui-tag ui-tag-{variant} ui-tag-{size} {closable ? 'ui-tag-closable' : ''}">
    <Text class="ui-tag-content">
        <slot />
    </Text>
    <if :condition="closable">
        <button class="ui-tag-close" type="button" aria-label="close" @click="handleClose">
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                <path d="M18 6 6 18M6 6l12 12" />
            </svg>
        </button>
        <else />
    </if>
</Text>
</widget>

<script>
let variant: utf8 = "default"
let closable: bool = false
let size: utf8 = "md"

micro handleClose() {
    emit("close", {})
}
</script>
<style>
