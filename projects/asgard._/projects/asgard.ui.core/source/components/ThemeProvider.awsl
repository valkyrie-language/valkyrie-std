<widget ThemeProvider>
<Box @class="asgard-root motion-{motion}">
    <slot />
</Box>
</widget>

<script>
let motion: utf8 = "narrative"

micro setMotion(m: utf8) {
    motion = m
    emit("motionChange", { motion: motion })
}
</script>
