<widget ThemeSwitcher>
<Box @class="ui-theme-switcher {expanded ? 'ui-theme-switcher-expanded' : ''}">
    <Box class="ui-theme-switcher-toggle">
        <button type="button" class="ui-theme-switcher-btn" @click="toggleExpand" aria-label="切换主题">
            <svg class="ui-theme-switcher-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="none" stroke="currentColor" stroke-width="var(--ui-icon-stroke, 2)" stroke-linecap="round" stroke-linejoin="round" d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4" />
            </svg>
        </button>
    </Box>
    <if :condition="expanded">
        <Box class="ui-theme-switcher-panel">
            <if :condition="themes.length > 1">
                <Box class="ui-theme-switcher-section">
                    <Text class="ui-theme-switcher-label">主题</Text>
                    <Box class="ui-theme-switcher-grid">
                        <loop item="t" :each="{themes}">
                            <button type="button" @class="ui-theme-switcher-chip {currentTheme == t.id ? 'ui-theme-switcher-chip-active' : ''}" @click="() => pickTheme(t.id)">
                                <Text class="ui-theme-switcher-chip-name">{t.label}</Text>
                            </button>
                        </loop>
                    </Box>
                </Box>
                <else />
            </if>
            <if :condition="modes.length > 1">
                <Box class="ui-theme-switcher-section">
                    <Text class="ui-theme-switcher-label">模式</Text>
                    <Box class="ui-theme-switcher-grid">
                        <loop item="m" :each="{modes}">
                            <button type="button" @class="ui-theme-switcher-chip {currentMode == m.id ? 'ui-theme-switcher-chip-active' : ''}" @click="() => pickMode(m.id)">
                                <Text class="ui-theme-switcher-chip-name">{m.label}</Text>
                            </button>
                        </loop>
                    </Box>
                </Box>
                <else />
            </if>
            <if :condition="themes.length > 1 || modes.length > 1">
                <Box class="ui-theme-switcher-hint">
                    <Text class="ui-theme-switcher-hint-text">theme / mode 由注册表驱动；站点模式 Auto 跟随系统。</Text>
                </Box>
                <else />
            </if>
        </Box>
        <else />
    </if>
</Box>
</widget>

<script>
let mut expanded: bool = false
let themes: list = []
let modes: list = []
let currentTheme: utf8 = "aether"
let currentMode: utf8 = "auto"

micro toggleExpand() {
    expanded = !expanded
    emit("toggle", { expanded: expanded })
}

micro pickTheme(id: utf8) {
    currentTheme = id
    emit("themeChange", { theme: id })
}

micro pickMode(id: utf8) {
    currentMode = id
    emit("modeChange", { mode: id })
}
</script>
<style>
.ui-theme-switcher {
    position: fixed;
    top: var(--ui-space-5);
    right: var(--ui-space-5);
    z-index: var(--ui-z-toast);
    font-family: var(--ui-font-sans);
}
.ui-theme-switcher-toggle {
    display: flex;
    justify-content: flex-end;
}
.ui-theme-switcher-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--ui-control-h-md);
    height: var(--ui-control-h-md);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-full);
    background: var(--sys-surface);
    color: var(--sys-on-bg);
    cursor: pointer;
    box-shadow: var(--sys-shadow);
    transition: all var(--ui-duration-1) var(--ui-easing);
}
.ui-theme-switcher-btn:hover {
    background: var(--sys-surface-hover);
    border-color: var(--sys-outline-focus);
}
.ui-theme-switcher-icon {
    flex-shrink: 0;
}
.ui-theme-switcher-panel {
    margin-top: var(--ui-space-2);
    padding: var(--ui-space-4);
    background: var(--sys-surface);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-lg);
    box-shadow: var(--sys-shadow-lg);
    min-width: 220px;
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-4);
}
.ui-theme-switcher-section {
    display: flex;
    flex-direction: column;
    gap: var(--ui-space-2);
}
.ui-theme-switcher-label {
    font-size: var(--ui-fs-xs);
    font-weight: 600;
    color: var(--sys-on-bg-secondary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
}
.ui-theme-switcher-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--ui-space-2);
}
.ui-theme-switcher-chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: calc(var(--ui-control-h-sm) - var(--ui-space-2));
    padding: 0 var(--ui-space-2);
    border: 1px solid var(--sys-outline);
    border-radius: var(--sys-radius-md);
    background: var(--sys-bg);
    color: var(--sys-on-bg-secondary);
    cursor: pointer;
    font-size: var(--ui-fs-sm);
    transition: all var(--ui-duration-1) var(--ui-easing);
    outline: none;
}
.ui-theme-switcher-chip:hover {
    border-color: var(--sys-outline-focus);
    color: var(--sys-on-bg);
}
.ui-theme-switcher-chip-active {
    background: var(--sys-primary);
    color: var(--sys-on-primary);
    border-color: var(--sys-primary);
}
.ui-theme-switcher-chip-active:hover {
    background: var(--sys-primary-hover);
    color: var(--sys-on-primary);
}
.ui-theme-switcher-chip-name {
    font-weight: 500;
}
.ui-theme-switcher-hint {
    padding-top: var(--ui-space-2);
    border-top: 1px solid var(--sys-outline);
}
.ui-theme-switcher-hint-text {
    font-size: var(--ui-fs-xs);
    color: var(--sys-on-bg-tertiary);
    line-height: var(--ui-lh-snug);
}

@media (max-width: 640px) {
    .ui-theme-switcher {
        top: var(--ui-space-3);
        right: var(--ui-space-3);
    }
    .ui-theme-switcher-panel {
        min-width: 180px;
    }
    .ui-theme-switcher-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>
