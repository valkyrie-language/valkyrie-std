{
    name: "atlas.tools",
    version: "workspace",
    description: "Atlas 后端框架 CLI — dev / serve / status / health / config validate",
    type: "application",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "atlas": { version: "workspace" }
    },
    build: [
        {
            target: "nyar"
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true
        }
    ]
}
