{
    name: "legion.tools",
    version: "workspace",
    description: "Legion 构造工具",
    auto_link: {
        core: true,
        std: false
    },
    dependencies: {
        "nyar": { version: "workspace" },
        "nyar.analyzer": { version: "workspace" },
        "nyar.optimizer": { version: "workspace" },
        "nyar.emitter": { version: "workspace" },
        "nyar.language": { version: "workspace" },
        "nyar.package_manager": { version: "workspace" },
        "nyar.package_registry": { version: "workspace" },
        "std": { version: "workspace" },
        "std.data.text.valkyrie": { version: "workspace" },
        "std.data.text.von": { version: "workspace" }
    },
    build: [
        {
            target: "clr",
            msil: true
        },
        {
            target: "jvm"
        },
        {
            target: "node"
        },
        {
            target: "wasi"
        },
        {
            target: "wasip3"
        },
        {
            target: "nyar"
        }
    ],
    publish: [
        {
            target: "node",
            type: "npm",
            package_id: "@valkyrie-language/legion",
            version: "2020.0.0"
        },
        {
            target: "node",
            type: "jsr",
            package_id: "@valkyrie/legion",
            version: "2020.0.0"
        },
    ]
}
