{
    name: "legion.tools",
    description: "Legion 构造工具",
    auto_link: {
        core: false,
        std: true
    },
    dependencies: {
        "std.data.text.von": { version: "workspace" }
    },
    build: [
        {
            target: "clr"
        },
        {
            target: "jvm"
        },
        {
            target: "wasm"
        },
        {
            target: "nyar"
        }
    ],
    publish: [
        {
            target: "clr",
            type: "nuget",
            package_id: "V.Legion"
        }
    ]
}
