{
    name: "nyar.analyzer",
    version: "workspace",
    description: "Nyar 语言无关分析层 — ProgramFacts / 中性程序事实（同构自 nyar-analyzer）",
    type: "library",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "nyar": { version: "workspace" }
    },
    build: [
        { target: "clr" },
        { target: "nyar" }
    ]
}
