{
    name: "nyar.emitter",
    version: "workspace",
    description: "Nyar 语言无关后端编排 — CLR·JVM·WASM·WASI lanes（同构自 nyar-emitter）",
    type: "library",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "nyar": { version: "workspace" },
        "nyar.analyzer": { version: "workspace" },
        "nyar.optimizer": { version: "workspace" },
        "std.data.text.msil": { version: "workspace" },
        "std.data.binary.clr": { version: "workspace" },
        "std.data.binary.class": { version: "workspace" },
        "std.data.binary.wasm": { version: "workspace" }
    },
    build: [
        { target: "clr" },
        { target: "jvm" },
        { target: "nyar" }
    ]
}
