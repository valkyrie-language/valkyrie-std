{
    name: "nyar.optimizer",
    version: "workspace",
    description: "Nyar 语言无关优化骨架 — Object Algebraic / E-Graph（同构自 nyar-optimizer）",
    type: "library",
    auto_link: {
        core: true,
        std: true
    },
    dependencies: {
        "nyar": { version: "workspace" },
        "nyar.analyzer": { version: "workspace" }
    },
    build: [
        { target: "clr" },
        { target: "nyar" }
    ]
}
