{
    name: "std.adaptor.wasi",
    description: "Valkyrie WASI 平台 SDK -- 基于 WASI component model 的宿主绑定",
    main: "source/time.v",
    dependencies: {
        "core": "workspace"
    },
    sdk-vendor: {
        organization: "valkyrie",
        host: "wasi",
        kind: "platform-sdk",
        targets: ["wasi"]
    },
    build: [
        {
            target: "wasi"
        }
    ],
    engines: {
        vcc: ">=0.1.0"
    }
}
