{
    name: "std.adaptor.wasm",
    description: "Valkyrie WebAssembly SDK -- Web 浏览器 API 绑定",
    main: "source/console.v",
    dependencies: {
        "core": "workspace"
    },
    build: [
        {
            target: "wasm32-unknown-browser-wasm",
            source_map: true,
            typescript: true,
            wat: true
        }
    ],
    engines: {
        vcc: ">=0.1.0"
    }
}
