{
    name: "std.adaptor.windows",
    description: "Valkyrie Windows SDK -- Windows 平台 API 绑定",
    main: "source/win32.v",
    dependencies: {
        "core": "workspace"
    },
    sdk-vendor: {
        organization: "valkyrie",
        host: "windows",
        kind: "platform-sdk",
        targets: ["x86_64-pc-windows-msvc"]
    },
    build: [
        {
            target: "nyar"
        }
    ],
    engines: {
        vcc: "0.1.*"
    }
}
