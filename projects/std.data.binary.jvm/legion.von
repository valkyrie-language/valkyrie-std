{
    name: "std.data.binary.jvm",
    version: "0.1.0",
    description: "JVM ClassFile 二进制解析库 - 解码 .class 字节流为结构化数据",
    license: "MIT",
    type: "library",
    dependencies: {
        core: false,
        std: false
    },
    build: [
        { target: "nyar" },
        { target: "clr" },
        { target: "jvm" },
        { target: "wasm" }
    ]
}