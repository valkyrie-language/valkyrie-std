{
    name: "std.data.text.wat",
    version: "0.1.0",
    description: "WAT 文本解析库 - 词法分析、语法解析为 AST",
    license: "MIT",
    type: "library",
    dependencies: {
        core: false,
        std: false,
        "std.data.text.v": "workspace"
    },
    build: [
        { target: "nyar" },
        { target: "clr" },
        { target: "jvm" },
        { target: "wasm" }
    ]
}