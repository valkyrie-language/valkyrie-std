{
    name: "std",
    description: "Valkyrie 标准库 -- 跨平台统一接口, 编译时分发到各平台 SDK",
    auto_link: {
        core: true,
        std: false
    },
    dependencies: {
        "std.adaptor.nyar": { version: "workspace", abi: "nyar" },
        "std.adaptor.clr": { version: "workspace", abi: "clr" },
        "std.adaptor.jvm": { version: "workspace", abi: "jvm" },
        "std.adaptor.windows": { version: "workspace", abi: "native" },
        "std.adaptor.linux": { version: "workspace", abi: "native" },
        "std.adaptor.macos": { version: "workspace", abi: "native" },
        "std.adaptor.wasm": { version: "workspace", abi: "wasm" },
        "std.adaptor.wasip1": { version: "workspace", abi: "wasip1" },
        "std.adaptor.wasip2": { version: "workspace", abi: "wasip2" }
    },
    build: [
        {
            target: "nyar"
        },
        {
            target: "clr-microsoft-unknown-managed",
            msil: true,
            exclude_directories: [
                "source/command",
                "source/math/graph_theory",
                "source/types"
            ],
            exclude_files: [
                "source/collection/sorted/BTreeMap.v",
                "source/collection/sorted/BTreeSet.v",
                "source/collection/BitSet.v",
                "source/collection/Deque.v",
                "source/collection/Hash.v",
                "source/collection/hashed/HashMap.v",
                "source/collection/hashed/HashPrimitives.v",
                "source/collection/hashed/HashSet.v",
                "source/collection/ordered/OrderedMap.v",
                "source/collection/ordered/OrderedSet.v",
                "source/collection/LinkedList.v",
                "source/collection/Map.v",
                "source/collection/PriorityQueue.v",
                "source/collection/Queue.v",
                "source/collection/RingBuffer.v",
                "source/collection/Set.v",
                "source/collection/sort.v",
                "source/collection/Stack.v",
                "source/io/read.v",
                "source/text/_.v",
                "source/text/AsciiText.v",
                "source/ffi/CText.v",
                "test/collection/test_core_collection.v",
                "source/text/Utf8Builder.v",
                "source/text/Utf8View.v",
                "source/text/utf8.v"
            ]
        },
        {
            target: "jvm-openjdk-unknown-managed",
            exclude_directories: [
                "source/command",
                "source/math/graph_theory",
                "source/types"
            ],
            exclude_files: [
                "source/collection/sorted/BTreeMap.v",
                "source/collection/sorted/BTreeSet.v",
                "source/collection/BitSet.v",
                "source/collection/Deque.v",
                "source/collection/Hash.v",
                "source/collection/hashed/HashMap.v",
                "source/collection/hashed/HashPrimitives.v",
                "source/collection/hashed/HashSet.v",
                "source/collection/ordered/OrderedMap.v",
                "source/collection/ordered/OrderedSet.v",
                "source/collection/LinkedList.v",
                "source/collection/Map.v",
                "source/collection/PriorityQueue.v",
                "source/collection/Queue.v",
                "source/collection/RingBuffer.v",
                "source/collection/Set.v",
                "source/collection/sort.v",
                "source/collection/Stack.v",
                "source/io/read.v",
                "source/text/_.v",
                "source/text/AsciiText.v",
                "source/ffi/CText.v",
                "test/collection/test_core_collection.v",
                "source/text/Utf8Builder.v",
                "source/text/Utf8View.v",
                "source/text/utf8.v"
            ]
        },
        {
            target: "wasm32-unknown-browser-wasm",
            source_map: true,
            typescript: true,
            wat: true
        }
    ],
    engines: {
        vcc: ">=0.1.0"
    }
}
